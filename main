local chestSection = CratesTab:CreateSector("Chests 🎁", "right")

local crateAmountToggle = crateSection:AddToggle("Open Amount", false, function() end)
crateAmountToggle:AddSlider(0, 0, 140, 10, function(value)
    crateOpenAmount = math.max(1, math.floor(value / 10))
end)

crateSection:AddTextbox("Or type amount", nil, function(value)
    local num = tonumber(value)
    if num then
        crateOpenAmount = math.max(1, math.floor(num))
    end
end)

for _, crate in pairs(crates) do
    crateSection:AddButton("Open " .. crate, function()
        game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("OpenCrate"):FireServer(crate, crateOpenAmount)
    end)
end

local chestAmountToggle = chestSection:AddToggle("Open Amount", false, function() end)
chestAmountToggle:AddSlider(0, 0, 140, 10, function(value)
    crateOpenAmount = math.max(1, math.floor(value / 10))
end)

chestSection:AddTextbox("Or type amount", nil, function(value)
    local num = tonumber(value)
    if num then
        crateOpenAmount = math.max(1, math.floor(num))
    end
end)

for _, chest in pairs(chests) do
    chestSection:AddButton("Open " .. chest, function()
        game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("OpenCrate"):FireServer(chest, crateOpenAmount)
    end)
end

-- Tab 6 Settings
local SettingsTab = Window:CreateTab("Settings")

local settingsSection = SettingsTab:CreateSector("Settings ⚙️", "left")

local antiAFKActive = false
settingsSection:AddToggle("Anti AFK", false, function(state)
    antiAFKActive = state
    if antiAFKActive then
        task.spawn(function()
            while antiAFKActive do
                task.wait(60)
                if antiAFKActive then
                    local VirtualUser = game:GetService("VirtualUser")
                    VirtualUser:Jump()
                end
            end
        end)
    end
end)

local infoSection = SettingsTab:CreateSector("Info ℹ️", "right")
infoSection:AddLabel("Anti AFK: Jumps every 60s")
infoSection:AddLabel("to prevent idle kick")
infoSection:AddLabel("UI Key: RightControl")
