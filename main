local AchievementTab = Window:CreateTab("Achievements")

local achievements = {
    "Roller", "Prospector", "Consumables", "Runic",
    "Reborn", "Evolution", "Chronos", "Highroller",
    "Resonance", "Breakthrough", "Exaltation", "Breaker",
    "Shatterer", "Obliterator", "Reality Breaker",
    "Eradicator", "Unboxing", "Quirky"
}

local autoAchievementSection = AchievementTab:CreateSector("Auto Claim 🏆", "left")
local manualAchievementSection = AchievementTab:CreateSector("Manual Claim 🏆", "right")
local achievementActive = {}

autoAchievementSection:AddToggle("Auto Claim All", false, function(state)
    for _, achievement in pairs(achievements) do
        achievementActive[achievement] = state
    end
    if state then
        task.spawn(function()
            while achievementActive[achievements[1]] do
                for _, achievement in pairs(achievements) do
                    game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("ClaimMastery"):FireServer(achievement)
                    task.wait(0.1)
                end
                task.wait(1)
            end
        end)
    end
end)

for _, achievement in pairs(achievements) do
    achievementActive[achievement] = false
    autoAchievementSection:AddToggle("Auto " .. achievement, false, function(state)
        achievementActive[achievement] = state
        if state then
            task.spawn(function()
                while achievementActive[achievement] do
                    game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("ClaimMastery"):FireServer(achievement)
                    task.wait(1)
                end
            end)
        end
    end)
end

manualAchievementSection:AddButton("Claim All", function()
    for _, achievement in pairs(achievements) do
        game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("ClaimMastery"):FireServer(achievement)
        task.wait(0.1)
    end
end)

for _, achievement in pairs(achievements) do
    manualAchievementSection:AddButton(achievement, function()
        game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("ClaimMastery"):FireServer(achievement)
    end)
end

-- Tab 4
local StatsTab = Window:CreateTab("Stats")
local player = game:GetService("Players").LocalPlayer
local Data = player:WaitForChild("Data")

local statFolders = {
    {name = "Currencies 💵", folder = "Currencies"},
    {name = "Stats 📊", folder = "Stats"},
    {name = "Items 🎒", folder = "Items"},
    {name = "Mastery 🏅", folder = "Mastery"},
    {name = "Obtained ✅", folder = "Obtained"},
}

for i, folderInfo in pairs(statFolders) do
    local side = (i % 2 == 0) and "right" or "left"
    local section = StatsTab:CreateSector(folderInfo.name, side)
    local folder = Data:WaitForChild(folderInfo.folder)
    local labels = {}
    for _, child in pairs(folder:GetChildren()) do
        local label = section:AddLabel(child.Name .. ": " .. formatNumber(child.Value))
        labels[child.Name] = label
    end
    task.spawn(function()
        while true do
            task.wait(1)
            for _, child in pairs(folder:GetChildren()) do
                if labels[child.Name] then
                    labels[child.Name]:Set(child.Name .. ": " .. formatNumber(child.Value))
                end
            end
        end
    end)
end

