    autoRollActive = state
    if autoRollActive then
        task.spawn(function()
            while autoRollActive do
                game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Roll"):FireServer()
                task.wait(rollDelay)
            end
        end)
    end
end)

