testSection:AddToggle("Auto Energy Pad", false, function(state)
    touchActive = state
    if touchActive then
        local character = game.Players.LocalPlayer.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        local button = workspace:WaitForChild("Boards"):WaitForChild("Energy"):WaitForChild("Energy Pad"):WaitForChild("Button")
        if not hrp or not button then return end
        touchConnection = game:GetService("RunService").Heartbeat:Connect(function()
            if not touchActive then
                touchConnection:Disconnect()
                touchConnection = nil
                return
            end
            hrp.CFrame = button.CFrame + Vector3.new(0, 3, 0)
        end)
    else
        if touchConnection then
            touchConnection:Disconnect()
            touchConnection = nil
        end
    end
end)

local rebirthSection = AimingTab:CreateSector("Auto Rebirth 🔄", "right")
local rebirthTypes = {"Prestige", "Ascension", "Transcension", "Overroll", "Crystallize"}
local rebirthActive = {}

for _, rebirthType in pairs(rebirthTypes) do
    rebirthActive[rebirthType] = false
    rebirthSection:AddToggle("Auto " .. rebirthType, false, function(state)
        rebirthActive[rebirthType] = state
        if state then
            task.spawn(function()
                while rebirthActive[rebirthType] do
                    local args = {rebirthType}
                    game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Reset"):FireServer(unpack(args))
                    task.wait(1)
                end
            end)
        end
    end)
end

local deleteSection = AimingTab:CreateSector("Other", "right")
deleteSection:AddButton("Delete UI", function()
    autoRollActive = false
    autoYatzyActive = false
    autoFlipActive = false
    autoQuirkActive = false
    autoClickActive = false
    autoGlyphActive = false
    touchActive = false
    if touchConnection then
        touchConnection:Disconnect()
        touchConnection = nil
    end
    for _, rebirthType in pairs(rebirthTypes) do
        rebirthActive[rebirthType] = false
    end
    Window.Main:Destroy()
end)

-- Tab 2
local UpgradeTab = Window:CreateTab("Upgrades")
local upgradeAmount = "1"
local useMax = false

local function fireUpgrade(arg1, arg3)
    local args = {arg1, upgradeAmount, arg3[1], arg3[2]}
    game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Upgrade"):FireServer(unpack(args))
end

local function createUpgradeSection(tab, autoName, manualName, upgrades, currency)
    local autoActive = {}
    local autoSection = tab:CreateSector(autoName, "left")
    autoSection:AddToggle("Max Upgrade", false, function(state)
        useMax = state
        upgradeAmount = state and "Max" or "1"
    end)
    for _, upgrade in pairs(upgrades) do
        autoActive[upgrade.arg] = false
        autoSection:AddToggle("Auto " .. upgrade.name, false, function(state)
            autoActive[upgrade.arg] = state
            if state then
                task.spawn(function()
                    while autoActive[upgrade.arg] do
                        fireUpgrade(upgrade.arg, currency)
                        task.wait(1)
                    end
                end)
            end
        end)
    end
    local manualSection = tab:CreateSector(manualName, "right")
    manualSection:AddToggle("Max Upgrade", false, function(state)
        useMax = state
        upgradeAmount = state and "Max" or "1"
    end)
    for _, upgrade in pairs(upgrades) do
        manualSection:AddButton(upgrade.name, function()
            fireUpgrade(upgrade.arg, currency)
        end)
    end
end

