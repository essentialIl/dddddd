local function formatNumber(n)
    local str = tostring(n)
    local tier, val = str:match("^(%d+);(.+)$")
    if tier and val then
        tier = tonumber(tier)
        val = tonumber(val)
        if tier == 0 then
            n = val
        else
            local suffixes = {"K", "M", "B", "T", "QD", "QN", "SX", "SP", "OC", "NO", "DC"}
            local decimals = val % 3
            local group = math.floor(val / 3)
            local display = string.format("%.2f", 10 ^ decimals)
            if suffixes[group] then
                return display .. suffixes[group]
            else
                return "e" .. string.format("%.1f", val)
            end
        end
    end
    local num = tonumber(n)
    if not num then return tostring(n) end
    local suffixes = {
        {1e33, "DC"}, {1e30, "NO"}, {1e27, "OC"}, {1e24, "SP"},
        {1e21, "SX"}, {1e18, "QN"}, {1e15, "QD"}, {1e12, "T"},
        {1e9, "B"}, {1e6, "M"}, {1e3, "K"},
    }
    for _, suffix in pairs(suffixes) do
        if math.abs(num) >= suffix[1] then
            return string.format("%.2f%s", num / suffix[1], suffix[2])
        end
    end
    return tostring(math.floor(num))
end

